VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_BUCKET_ASSETS=mailer_assets
VITE_DEFAULT_ACTOR_ID=00000000-0000-0000-0000-000000000001
VITE_N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/disruptia-mailer
VITE_N8N_WEBHOOK_SECRET_HEADER=x-disruptia-webhook-secret
VITE_N8N_WEBHOOK_SECRET=change-me

# WhatsApp (YCloud vía N8N — ver docs/n8n-whatsapp-flow.md).
# Usa el mismo header de secreto que el webhook de email.
VITE_N8N_WHATSAPP_WEBHOOK_URL=https://n8n.your-domain.com/webhook/disruptia-whatsapp
VITE_N8N_WHATSAPP_WEBHOOK_SECRET=change-me

# Generación de plantillas con IA (frente 3):
# La ANTHROPIC_API_KEY NO va aquí — vive como secreto en la Edge Function
# `generate-template` (ver supabase/functions/generate-template/README.md).
# El front deriva la URL de la función desde VITE_SUPABASE_URL; no requiere
# variables nuevas.
