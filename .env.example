VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_BUCKET_ASSETS=mailer_assets
VITE_DEFAULT_ACTOR_ID=00000000-0000-0000-0000-000000000001

# WhatsApp: poné "false" para esconder el envío real en la UI (por defecto está
# habilitado). El workflow de N8N se documenta en docs/n8n-whatsapp-flow.md.
VITE_WHATSAPP_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Desde la fase 5 el navegador NO habla con N8N: llama a la Edge Function
# `dispatch-runner`, la única que conoce las URLs y los secretos de los webhooks.
# Por eso ya NO existen VITE_N8N_* — esos valores son SECRETOS DE LA FUNCIÓN:
#
#   npx supabase secrets set \
#     N8N_EMAIL_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/envio-correos \
#     N8N_WEBHOOK_SECRET=... \
#     N8N_WEBHOOK_SECRET_HEADER=x-disruptia-webhook-secret \
#     N8N_WHATSAPP_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/envio-whatsapp \
#     N8N_WHATSAPP_WEBHOOK_SECRET=... \
#     --project-ref <ref>
#
# Lo mismo la ANTHROPIC_API_KEY de la función `generate-template`.
# El front deriva la URL de las funciones desde VITE_SUPABASE_URL.
# Guía del reloj que dispara el despachador: docs/n8n-dispatch-runner.md
# ─────────────────────────────────────────────────────────────────────────────
